#!/usr/bin/env bash
set -Eeuo pipefail

readonly application_name="ecommerce-api"
readonly application_root="/opt/ecommerce-api"
readonly releases_dir="$application_root/releases"
readonly current_link="$application_root/current.jar"
readonly health_url="http://127.0.0.1:8080/actuator/health"
readonly release_name="${1:-}"

if [[ ! "$release_name" =~ ^ecommerce_api-[0-9]+-[0-9a-f]{7,40}\.jar$ ]]; then
  echo "Invalid release name." >&2
  exit 2
fi

readonly candidate="$releases_dir/$release_name"
if [[ ! -f "$candidate" ]]; then
  echo "Release does not exist: $candidate" >&2
  exit 2
fi

previous_target=""
if [[ -L "$current_link" ]]; then
  previous_target="$(readlink -f "$current_link")"
fi

check_health() {
  local response
  for attempt in {1..30}; do
    if response="$(curl --fail --silent --show-error --max-time 3 "$health_url")" \
      && grep -Eq '"status"[[:space:]]*:[[:space:]]*"UP"' <<< "$response"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

chown ecommerce:ecommerce "$candidate"
chmod 0644 "$candidate"
ln -sfnT "$candidate" "$current_link"
chown -h ecommerce:ecommerce "$current_link"

systemctl restart "$application_name.service"
if check_health; then
  echo "Activated $release_name"
  exit 0
fi

echo "Health check failed for $release_name; rolling back." >&2
if [[ -n "$previous_target" && -f "$previous_target" ]]; then
  ln -sfnT "$previous_target" "$current_link"
  chown -h ecommerce:ecommerce "$current_link"
  systemctl restart "$application_name.service"
  check_health || echo "Rollback health check also failed." >&2
else
  echo "No previous release is available for rollback." >&2
fi

exit 1